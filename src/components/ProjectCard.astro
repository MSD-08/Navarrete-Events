---
import Img from './Img.astro';
import { path, type Lang } from '../i18n/routes';
import { ui } from '../copy/common';
import { projectLabel, type Project } from '../data/projects';

interface Props {
  project: Project;
  lang: Lang;
  index?: number;
  size?: 'lg' | 'md' | 'sm';
  sizes?: string;
  delay?: number;
}
const { project: p, lang, index, size = 'md', sizes = '(min-width: 900px) 45vw, 92vw', delay = 0 } = Astro.props;
const t = ui(lang);
---
<article class:list={['card', `card--${size}`]} data-category={p.category} data-reveal style={`--delay:${delay}s`}>
  <a href={path(lang, 'portfolio', p.slug)} class="card__link">
    <div class="card__media media">
      <Img id={p.cover} alt="" sizes={sizes} />
    </div>
    <div class="card__meta">
      {index !== undefined && <span class="num card__num">{String(index).padStart(2, '0')}</span>}
      <div>
        <p class="label">{t.categorySingular[p.category]} · {projectLabel(p, lang)}</p>
        <h3 class="card__title serif">{p.title[lang]}</h3>
      </div>
    </div>
    <span class="visually-hidden">— {t.viewProject}</span>
  </a>
</article>

<style>
  .card__link { display: block; }
  .card__media { aspect-ratio: 4 / 5; }
  .card--lg .card__media { aspect-ratio: 4 / 5; }
  .card--sm .card__media { aspect-ratio: 3 / 4; }
  .card__media :global(img) { transition: transform 1.8s var(--ease-out), filter 1.2s var(--ease); }
  .card__link:hover .card__media :global(img) { transform: scale(1.035); }
  .card__meta { display: flex; gap: 1.1rem; align-items: baseline; margin-top: 1.15rem; }
  .card__num { font-size: 1rem; min-width: 1.6rem; }
  .card__meta .label { display: flex; }
  .card__title {
    margin-top: 0.4rem;
    font-size: clamp(1.35rem, 1.9vw, 1.95rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    font-style: italic;
  }
  .card--lg .card__title { font-size: clamp(1.6rem, 2.6vw, 2.6rem); }
  .card__title { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 0.9s var(--ease-out); display: inline; }
  .card__link:hover .card__title { background-size: 100% 1px; }
</style>
