---
import Img from './Img.astro';
import { path, type Lang } from '../i18n/routes';
import { ui } from '../copy/common';
import { home } from '../copy/home';
import { getProject, projectLabel } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const c = home[lang].hero;

/** Opening sequence — the strongest frames of the archive. */
const heroSlides = [
  { id: 'boda-ta/hero', project: 'boda-ta', position: '50% 0%', alt: { es: 'Novios sentados al centro de un salón drapeado, bajo un candil de cristal y entre mesas imperiales con velas', en: 'A couple seated at the centre of a draped room, beneath a crystal chandelier and between candlelit imperial tables' } },
  { id: 'boda-ek/g11', project: 'boda-ek', position: '50% 0%', alt: { es: 'Columna escultórica de varillas blancas cubierta de follaje y flores blancas en un salón oscuro', en: 'A sculptural column of white rods wrapped in foliage and white flowers in a dark room' } },
  { id: 'boda-dm/g11', project: 'boda-dm', position: '50% 0%', alt: { es: 'Novios abrazados bajo un arco ornamentado iluminado en tonos dorados', en: 'A couple embracing beneath an ornate arch lit in golden tones' } },
  { id: 'boda-jc/g15', project: 'boda-jc', position: '50% 0%', alt: { es: 'Novios frente a una instalación de orquídeas blancas y candelabros de cristal bajo un cielo estrellado', en: 'A couple before an installation of white orchids and crystal candelabra beneath a starlit ceiling' } },
] as const;
---
<section class="hero is-dark grain" data-hero aria-roledescription={lang === 'es' ? 'carrusel' : 'carousel'} aria-label={lang === 'es' ? 'Obra seleccionada' : 'Selected work'}>
  <div class="hero__stage">
    <div class="hero__frame" data-hero-frame>
      {heroSlides.map((s, i) => (
        <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i === 0 ? undefined : 'true'}>
          <Img id={s.id} alt={s.alt[lang]} sizes="(min-width: 1024px) 40vw, 100vw" priority={i === 0} class="hero__pic" position={s.position} />
        </div>
      ))}
    </div>
  </div>

  <div class="hero__content wrap">
    <p class="hero__eyebrow label" data-hero-in style="--d:0.5s">{c.eyebrow}</p>

    <h1 class="hero__title display">
      <span class="hero__line" data-hero-in style="--d:0.25s">{c.title[0]}</span>
      <span class="hero__line hero__line--2" data-hero-in style="--d:0.4s"><em>{c.title[1]}</em></span>
    </h1>

    <div class="hero__aside" data-hero-in style="--d:0.75s">
      <p class="hero__lede">{c.lede}</p>
      <div class="cta-row">
        <a class="btn" href={path(lang, 'inquiry')}>{t.startProject}</a>
        <a class="link" href={path(lang, 'portfolio')}>{t.explorePortfolio} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="hero__index" data-hero-in style="--d:0.9s">
      <p class="hero__count" aria-live="polite">
        <span class="num" data-hero-current>01</span>
        <span class="hero__sep" aria-hidden="true"></span>
        <span class="num">{String(heroSlides.length).padStart(2, '0')}</span>
      </p>
      <ul class="hero__captions" role="list">
        {heroSlides.map((s, i) => {
          const p = getProject(s.project)!;
          return (
            <li class:list={['hero__caption', { 'is-active': i === 0 }]} data-caption>
              <a href={path(lang, 'portfolio', p.slug)} tabindex={i === 0 ? undefined : -1}>
                <span class="label">{t.categorySingular[p.category]} · {projectLabel(p, lang)}</span>
                <span class="hero__caption-title">{p.title[lang]}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <button class="hero__pause" type="button" data-hero-pause aria-pressed="false" data-label-pause={c.pause} data-label-play={c.play} aria-label={c.pause}>
        <span aria-hidden="true" class="hero__pause-icon"></span>
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: max(100svh, 40rem);
    display: grid;
    overflow: hidden;
    background: #1d1713;
  }
  .hero__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .hero__frame {
    position: relative;
    width: min(42vw, 76vh);
    height: min(80svh, 60rem);
    margin-top: calc(var(--header-h) * 0.6);
    overflow: hidden;
  }
  .hero__slide { position: absolute; inset: 0; opacity: 0; transition: opacity 2s var(--ease); }
  .hero__slide.is-active { opacity: 1; }
  .hero__slide :global(.hero__pic), .hero__slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__slide :global(img) { transform: scale(1.08); transition: transform 9s linear; }
    .hero__slide.is-active :global(img) { transform: scale(1); }
    :global(.js) .hero__frame { clip-path: inset(50% 0 50% 0); animation: hero-open 1.6s var(--ease-out) 0.1s forwards; }
    :global(.js) [data-hero-in] { opacity: 0; transform: translateY(22px); animation: hero-in 1.4s var(--ease-out) forwards; animation-delay: var(--d, 0s); }
  }
  @keyframes hero-open { to { clip-path: inset(0 0 0 0); } }
  @keyframes hero-in { to { opacity: 1; transform: none; } }

  .hero__content {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr min(42vw, 76vh) 1fr;
    grid-template-rows: 1fr auto;
    column-gap: clamp(1.5rem, 3vw, 3.5rem);
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
    min-height: inherit;
  }
  .hero__eyebrow { grid-column: 1; grid-row: 1; align-self: start; margin-top: 4vh; color: #d9cbb8; }
  .hero__title {
    grid-column: 1 / -1;
    grid-row: 1;
    align-self: center;
    display: grid;
    color: #f6efe4;
    text-shadow: 0 2px 40px rgb(0 0 0 / 0.25);
    font-variation-settings: 'opsz' 96;
  }
  .hero__line { display: block; }
  .hero__line--2 { justify-self: end; margin-top: -0.04em; }
  .hero__aside { grid-column: 1; grid-row: 2; align-self: end; max-width: 25rem; }
  .hero__lede { color: #e2d6c5; font-size: 1.02rem; line-height: 1.65; margin-bottom: 1.75rem; }
  .hero__aside .link { color: #f6efe4; }
  .hero__index {
    grid-column: 3;
    grid-row: 2;
    align-self: end;
    justify-self: end;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 1.5rem;
    max-width: 22rem;
    width: 100%;
  }
  .hero__count { display: flex; align-items: center; gap: 0.7rem; font-size: 1.05rem; }
  .hero__sep { width: 2.25rem; height: 1px; background: currentColor; opacity: 0.5; }
  .hero__captions { position: relative; min-height: 3.6rem; }
  .hero__caption { position: absolute; inset: auto 0 0 0; opacity: 0; transform: translateY(8px); transition: opacity 1s var(--ease), transform 1s var(--ease); pointer-events: none; }
  .hero__caption.is-active { opacity: 1; transform: none; pointer-events: auto; }
  .hero__caption a { display: grid; gap: 0.3rem; }
  .hero__caption .label { color: #cdbfac; }
  .hero__caption-title { font-family: var(--serif); font-style: italic; font-size: 1.1rem; line-height: 1.25; color: #f6efe4; }
  .hero__pause {
    display: grid; place-items: center;
    width: 44px; height: 44px;
    border: 1px solid rgb(246 239 228 / 0.35);
    border-radius: 50%;
    color: #f6efe4;
    transition: border-color 0.4s var(--ease);
  }
  .hero__pause:hover { border-color: #f6efe4; }
  .hero__pause-icon { width: 8px; height: 10px; border-inline: 2px solid currentColor; }
  .hero__pause[aria-pressed='true'] .hero__pause-icon {
    width: 0; height: 0; border-inline: 0;
    border-style: solid; border-width: 5px 0 5px 8px;
    border-color: transparent transparent transparent currentColor;
    margin-left: 2px;
  }

  /* Tablet & mobile: the photograph becomes full-bleed */
  @media (max-width: 1023px) {
    .hero__frame { width: 100%; height: 100%; margin: 0; }
    .hero__stage::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgb(22 17 14 / 0.55) 0%, rgb(22 17 14 / 0) 26%),
        linear-gradient(0deg, rgb(22 17 14 / 0.88) 0%, rgb(22 17 14 / 0.35) 45%, rgb(22 17 14 / 0) 70%);
    }
    .hero__content {
      grid-template-columns: 1fr auto;
      grid-template-rows: 1fr auto auto;
      row-gap: 1.75rem;
      padding-top: calc(var(--header-h) + 1.5rem);
    }
    .hero__eyebrow { grid-column: 1 / -1; grid-row: 1; margin-top: 0; }
    .hero__title { grid-column: 1 / -1; grid-row: 2; align-self: end; font-size: clamp(3.4rem, 15.5vw, 7.5rem); }
    .hero__line--2 { justify-self: start; padding-left: 0.6em; }
    .hero__aside { grid-column: 1 / -1; grid-row: 3; max-width: 34rem; }
    .hero__index { grid-column: 1 / -1; grid-row: 4; justify-self: stretch; max-width: none; padding-top: 1.25rem; border-top: 1px solid rgb(246 239 228 / 0.2); }
  }
  @media (max-width: 480px) {
    .hero__aside .cta-row { flex-direction: column; align-items: stretch; gap: 0.5rem; }
    .hero__aside .btn { width: 100%; }
    .hero__aside .link { justify-content: center; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const captions = [...root.querySelectorAll<HTMLElement>('[data-caption]')];
    const current = root.querySelector<HTMLElement>('[data-hero-current]')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-hero-pause]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer: number | undefined;
    let paused = reduce;

    const show = (n: number) => {
      slides[i].classList.remove('is-active');
      slides[i].setAttribute('aria-hidden', 'true');
      captions[i].classList.remove('is-active');
      captions[i].querySelector('a')!.tabIndex = -1;
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-active');
      slides[i].removeAttribute('aria-hidden');
      captions[i].classList.add('is-active');
      captions[i].querySelector('a')!.removeAttribute('tabindex');
      current.textContent = String(i + 1).padStart(2, '0');
      // Warm the next image
      const next = slides[(i + 1) % slides.length].querySelector('img');
      if (next) next.loading = 'eager';
    };
    const start = () => { stop(); timer = window.setInterval(() => show(i + 1), 6500); };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const setPaused = (p: boolean) => {
      paused = p;
      pauseBtn.setAttribute('aria-pressed', String(p));
      pauseBtn.setAttribute('aria-label', p ? pauseBtn.dataset.labelPlay! : pauseBtn.dataset.labelPause!);
      p ? stop() : start();
    };
    pauseBtn.addEventListener('click', () => setPaused(!paused));
    setPaused(paused);

    // Only cycle while the hero is visible.
    new IntersectionObserver(([e]) => { if (!paused) (e.isIntersecting ? start() : stop()); }).observe(root);
    document.addEventListener('visibilitychange', () => { if (!paused) (document.hidden ? stop() : start()); });
  }
</script>
