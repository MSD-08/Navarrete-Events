---
/** Root: Spanish is the default; returning visitors who chose English are sent to /en/. */
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Navarrete Events</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={new URL('/es/', Astro.site).href} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/es/', Astro.site).href} />
    <script is:inline>
      (function () {
        var lang = 'es';
        try { if (localStorage.getItem('ne-lang') === 'en') lang = 'en'; } catch (e) {}
        location.replace('/' + lang + '/');
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/es/" /></noscript>
    <style>body{background:#f7f2ea;color:#231b16;font-family:Georgia,serif;display:grid;place-items:center;min-height:100vh;margin:0}</style>
  </head>
  <body>
    <p><a href="/es/">Navarrete Events — Español</a> · <a href="/en/">English</a></p>
  </body>
</html>
