---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { path, otherLang, type Lang } from '../i18n/routes';
import { ui } from '../copy/common';
import { journalCopy } from '../copy/journal';
import { getProject } from '../data/projects';
import { formatDate, getTranslation, readingTime, type Article } from '../lib/journal';
import { site } from '../data/site';
import { srcset } from '../lib/media';

interface Props { article: Article; lang: Lang }
const { article: a, lang } = Astro.props;
const t = ui(lang);
const c = journalCopy[lang];
const { Content } = await render(a);
const translation = await getTranslation(a);
const alternate = translation ? path(otherLang(lang), 'journal', translation.data.slug) : path(otherLang(lang), 'journal');
const related = a.data.related.map((s) => getProject(s)).filter(Boolean) as NonNullable<ReturnType<typeof getProject>>[];
const min = readingTime(a.body);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.data.title,
  description: a.data.dek,
  inLanguage: lang,
  image: `${site.url}/media/${a.data.cover}-960.jpg`,
  author: { '@type': 'Organization', name: 'Navarrete Events' },
  publisher: { '@type': 'Organization', name: 'Navarrete Events', logo: { '@type': 'ImageObject', url: `${site.url}/brand/logo.png` } },
  ...(a.data.date ? { datePublished: a.data.date.toISOString() } : {}),
};
---
<Base
  lang={lang}
  title={a.data.title}
  description={a.data.dek}
  alternate={alternate}
  current="journal"
  image={a.data.cover}
  type="article"
  noindex={a.data.draft}
  preload={{ id: a.data.cover, srcset: srcset(a.data.cover, 'avif'), sizes: '100vw' }}
  jsonLd={a.data.draft ? undefined : jsonLd}
>
  <article class="art">
    <header class="art-head wrap">
      <p class="label art-head__meta">
        <a href={path(lang, 'journal')}>{c.label}</a>
        <span aria-hidden="true">/</span>
        <span>{a.data.category}</span>
        <span aria-hidden="true">·</span>
        <span>{min} {c.minutes}</span>
      </p>
      {a.data.draft && <p class="art-draft"><span class="label">{t.draft}</span> <span class="fig">{t.draftNote}</span></p>}
      {!a.data.draft && a.data.date && <p class="label">{c.published} <time datetime={a.data.date.toISOString()}>{formatDate(a.data.date, lang)}</time></p>}
      <h1 class="display art-head__title" data-reveal>{a.data.title}</h1>
      <p class="lead art-head__dek" data-reveal>{a.data.dek}</p>
    </header>

    <div class="art-cover media" data-reveal="image">
      <Img id={a.data.cover} alt={a.data.coverAlt} sizes="100vw" priority />
    </div>

    <div class="art-body wrap">
      <div class="article-prose">
        <Content />
      </div>
    </div>

    {related.length > 0 && (
      <section class="art-related is-cream section" aria-labelledby="rel-title">
        <div class="wrap">
          <h2 id="rel-title" class="label label--rule">{c.related}</h2>
          <div class="art-related__grid">
            {related.map((p, i) => <ProjectCard project={p} lang={lang} index={i + 1} sizes="(min-width: 900px) 30vw, 92vw" delay={i * 0.08} />)}
          </div>
          <p class="mt-l"><a class="link" href={path(lang, 'journal')}>{c.back} <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .art-head { padding-top: calc(var(--header-h) + clamp(3.5rem, 8vw, 7rem)); padding-bottom: clamp(3rem, 6vw, 5rem); display: grid; gap: 1.5rem; max-width: 72rem; }
  .art-head__meta { flex-wrap: wrap; gap: 0.6rem; }
  .art-head__meta a { min-height: 44px; display: inline-flex; align-items: center; }
  .art-head__meta a:hover { color: var(--fg); }
  .art-draft { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: baseline; padding: 0.9rem 1.1rem; border: 1px solid var(--line); width: fit-content; }
  .art-draft .label { color: var(--accent); }
  .art-head__title { font-size: clamp(3rem, 7.5vw, 8rem); max-width: 14ch; }
  .art-head__dek { max-width: 40rem; color: var(--fg-soft); }
  .art-cover { height: min(88svh, 60rem); }
  .art-cover :global(picture), .art-cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .art-body { padding-block: clamp(4rem, 9vw, 8rem); }
  .art-related__grid { margin-top: 3rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem clamp(1.5rem, 3vw, 3rem); }
  @media (max-width: 899px) { .art-related__grid { grid-template-columns: 1fr; } }

  /* Long-form reading */
  .article-prose { max-width: 40rem; margin-inline: auto; font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem); line-height: 1.8; color: var(--fg); }
  .article-prose :global(p) { margin-top: 1.4em; }
  .article-prose :global(> p:first-child) { margin-top: 0; }
  .article-prose :global(> p:first-child::first-letter) {
    float: left;
    font-family: var(--serif);
    font-size: 4.6em;
    line-height: 0.82;
    padding: 0.08em 0.12em 0 0;
    color: var(--accent);
  }
  .article-prose :global(h2) { margin-top: 2.6em; font-family: var(--serif); font-size: clamp(1.7rem, 2.6vw, 2.4rem); line-height: 1.15; letter-spacing: -0.015em; }
  .article-prose :global(h3) { margin-top: 2em; font-family: var(--serif); font-style: italic; font-size: 1.4rem; }
  .article-prose :global(em) { font-style: italic; }
  .article-prose :global(a) { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  .article-prose :global(hr) { margin: 3.5em auto 0; width: 4rem; border: 0; height: 1px; background: var(--line); }
  .article-prose :global(hr + p) { color: var(--fg-soft); font-size: 0.92em; }
  .article-prose :global(blockquote) { margin: 2.5em 0; padding-left: 1.5rem; border-left: 1px solid var(--accent); font-family: var(--serif); font-style: italic; font-size: 1.4em; line-height: 1.4; }
  .article-prose :global(.article-figure) { margin-block: 3em; }
  .article-prose :global(.article-figure--single) { margin-inline: calc((min(62rem, 100vw - 2 * var(--gutter)) - 100%) / -2); }
  .article-prose :global(.article-figure--pair) { margin-inline: calc((min(56rem, 100vw - 2 * var(--gutter)) - 100%) / -2); }
  .article-prose :global(.article-figure__media) { display: grid; gap: clamp(0.75rem, 2vw, 1.5rem); }
  .article-prose :global(.article-figure--pair .article-figure__media) { grid-template-columns: 1fr 1fr; align-items: start; }
  .article-prose :global(.article-figure img) { width: 100%; }
  .article-prose :global(.article-figure figcaption) { margin-top: 0.9rem; font-size: 0.9rem; }
</style>
